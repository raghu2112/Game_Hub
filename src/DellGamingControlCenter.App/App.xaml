<Application x:Class="DellGamingControlCenter.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DellGamingControlCenter.App.Converters"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkGamingTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource AppBackgroundPrimary}"/>
                <Setter Property="Foreground" Value="{StaticResource AppTextPrimary}"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AppTextPrimary}"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
