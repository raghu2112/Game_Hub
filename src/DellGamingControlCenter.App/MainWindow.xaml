<Window x:Class="DellGamingControlCenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:DellGamingControlCenter.App.ViewModels"
        xmlns:views="clr-namespace:DellGamingControlCenter.App.Views"
        Title="Dell Gaming &amp; Performance Control Center" 
        Height="750" Width="1200" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundPrimary}">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:GameCenterViewModel}">
            <views:GameCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PerformanceViewModel}">
            <views:PerformanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DiagnosticsViewModel}">
            <views:DiagnosticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SessionsViewModel}">
            <views:SessionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:HardwareViewModel}">
            <views:HardwareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BenchmarkViewModel}">
            <views:BenchmarkView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation -->
        <Border Grid.Column="0" Background="{StaticResource AppBackgroundSecondary}" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="20,30,20,40">
                    <TextBlock Text="DGC" FontFamily="{StaticResource PrimaryFont}" FontSize="32" FontWeight="Black" Foreground="{StaticResource AppAccent}"/>
                    <TextBlock Text="D E L L   G A M I N G   C E N T E R" FontFamily="{StaticResource PrimaryFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AppTextSecondary}" Margin="0,5,0,0" />
                </StackPanel>

                <!-- Nav Buttons -->
                <StackPanel Grid.Row="1">
                    <Button Content="Dashboard" Command="{Binding NavigateDashboardCommand}" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="Game Center" Command="{Binding NavigateGameCenterCommand}" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="Performance" Command="{Binding NavigatePerformanceCommand}" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="Diagnostics" Command="{Binding NavigateDiagnosticsCommand}" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="Sessions" Command="{Binding NavigateSessionsCommand}" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="Hardware" Command="{Binding NavigateHardwareCommand}" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="Benchmarks" Command="{Binding NavigateBenchmarksCommand}" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>
                
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <Button Content="Settings" Command="{Binding NavigateSettingsCommand}" Style="{StaticResource NavButtonStyle}" Margin="10,0"/>
                    <TextBlock Text="{Binding Version}" Foreground="{StaticResource AppTextSecondary}" FontSize="11" Margin="20,10,20,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="0" />
    </Grid>
</Window>
