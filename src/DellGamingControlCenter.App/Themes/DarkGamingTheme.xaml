<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════
         GamerHub Precision Depth Design System
         Deep obsidian/graphite base, machined gunmetal surfaces, dark recessed
         telemetry wells, technical typography, restrained cyber accents,
         and structured 1px geometric borders.
         Single source of truth. Views must not hard-code colors.
         ══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Colors: surfaces (spec §3.1) ─────────────────────────────────── -->
    <Color x:Key="AppBackgroundPrimaryColor">#171521</Color>   <!-- main app background -->
    <Color x:Key="AppBackgroundSecondaryColor">#211E30</Color> <!-- primary cards/panels -->
    <Color x:Key="AppBackgroundTertiaryColor">#29243B</Color>  <!-- raised/extruded cards -->
    <Color x:Key="AppInsetSurfaceColor">#191725</Color>        <!-- recessed meters/containers -->
    <Color x:Key="AppClayHighlightColor">#362F4A</Color>       <!-- subtle highlight -->
    <Color x:Key="AppBorderColor">#3D3552</Color>              <!-- subtle edge -->
    <Color x:Key="AppBorderLiftColor">#4A4066</Color>          <!-- lit top edge for extrusion -->

    <!-- ── Colors: accents (spec §3.1) ──────────────────────────────────── -->
    <Color x:Key="AppAccentColor">#A78BFA</Color>              <!-- primary accent (precision violet) -->
    <Color x:Key="AppAccentHoverColor">#C4B5FD</Color>         <!-- accent hover -->
    <Color x:Key="AppAccentDimColor">#4C3F7A</Color>           <!-- selected fill -->
    <Color x:Key="AppAccentSecondaryColor">#C4B5FD</Color>     <!-- highlights/selected values -->
    <Color x:Key="AppTelemetryColor">#67E8F9</Color>           <!-- cyan telemetry accent -->
    <Color x:Key="AppMagentaColor">#EC4899</Color>             <!-- optional highlight -->
    <Color x:Key="AppInfoColor">#67E8F9</Color>                <!-- information = cyan -->

    <!-- ── Colors: text (spec §3.1) ─────────────────────────────────────── -->
    <Color x:Key="AppTextPrimaryColor">#F4F0FF</Color>
    <Color x:Key="AppTextSecondaryColor">#B8B2CC</Color>
    <Color x:Key="AppTextMutedColor">#918BA7</Color>

    <!-- ── Colors: status (spec §3.1) ───────────────────────────────────── -->
    <Color x:Key="SuccessColor">#86EFAC</Color>                <!-- confirmed healthy/success -->
    <Color x:Key="WarningColor">#FCD34D</Color>                <!-- warning state -->
    <Color x:Key="ErrorColor">#FDA4AF</Color>                  <!-- error state -->

    <!-- ── Brushes: surfaces (spec §3.1, §3.3) ──────────────────────────── -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundPrimaryColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource AppBackgroundSecondaryColor}" />
    <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="{StaticResource AppBackgroundTertiaryColor}" />
    <SolidColorBrush x:Key="InsetSurfaceBrush" Color="{StaticResource AppInsetSurfaceColor}" />
    <SolidColorBrush x:Key="AppClayHighlight" Color="{StaticResource AppClayHighlightColor}" />
    <SolidColorBrush x:Key="AppBorder" Color="{StaticResource AppBorderColor}" />
    <SolidColorBrush x:Key="AppBorderLift" Color="{StaticResource AppBorderLiftColor}" />

    <!-- Precision extrusion: subtle lit top edge to dark bottom edge -->
    <LinearGradientBrush x:Key="ClayEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A4166" Offset="0"/>
        <GradientStop Color="#332C46" Offset="0.5"/>
        <GradientStop Color="#1C1829" Offset="1"/>
    </LinearGradientBrush>

    <!-- Card face: solid/subtle machined panel surface with restrained gradient -->
    <LinearGradientBrush x:Key="ClayCardFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#252136" Offset="0"/>
        <GradientStop Color="#201C2F" Offset="0.5"/>
        <GradientStop Color="#1C1929" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ClayCardFaceHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2C2740" Offset="0"/>
        <GradientStop Color="#252137" Offset="0.5"/>
        <GradientStop Color="#201C2E" Offset="1"/>
    </LinearGradientBrush>

    <!-- Recessed inset surface for meters/graphs/wells: darker top gives pressed-in depth -->
    <LinearGradientBrush x:Key="ClayInsetBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#12101C" Offset="0"/>
        <GradientStop Color="#161424" Offset="0.4"/>
        <GradientStop Color="#1A182A" Offset="1"/>
    </LinearGradientBrush>

    <!-- Recessed inset border: dark top shadow, faint bottom bounce -->
    <LinearGradientBrush x:Key="ClayInsetBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0D0B16" Offset="0"/>
        <GradientStop Color="#221D33" Offset="0.5"/>
        <GradientStop Color="#3B3256" Offset="1"/>
    </LinearGradientBrush>

    <!-- Primary button face: crisp precision accent with tactile depth -->
    <LinearGradientBrush x:Key="ClayPrimaryFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B392FA" Offset="0"/>
        <GradientStop Color="#9B73F7" Offset="0.55"/>
        <GradientStop Color="#8352EB" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ClayPrimaryFaceHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C4A8FF" Offset="0"/>
        <GradientStop Color="#AB88FF" Offset="0.5"/>
        <GradientStop Color="#9366F5" Offset="1"/>
    </LinearGradientBrush>

    <!-- Primary button pressed face: recessed darker accent -->
    <LinearGradientBrush x:Key="ClayPrimaryFacePressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6E3ED6" Offset="0"/>
        <GradientStop Color="#7F4FE6" Offset="1"/>
    </LinearGradientBrush>

    <!-- Nav rail selected item face -->
    <LinearGradientBrush x:Key="ClayNavSelectedFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#382A5E" Offset="0"/>
        <GradientStop Color="#271C44" Offset="1"/>
    </LinearGradientBrush>

    <!-- Shadow-like dark gradient for card depth -->
    <LinearGradientBrush x:Key="CardOuterShadowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141120" Offset="0"/>
        <GradientStop Color="#0A0812" Offset="1"/>
    </LinearGradientBrush>

    <!-- Inner highlight for raised surfaces -->
    <LinearGradientBrush x:Key="CardInnerHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FFFFFF" Offset="0.3"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── Brushes: accents ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource AppAccentSecondaryColor}" />
    <SolidColorBrush x:Key="TelemetryAccentBrush" Color="{StaticResource AppTelemetryColor}" />
    <SolidColorBrush x:Key="AppAccent" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="AppAccentHover" Color="{StaticResource AppAccentHoverColor}" />
    <SolidColorBrush x:Key="AppAccentDim" Color="{StaticResource AppAccentDimColor}" />
    <SolidColorBrush x:Key="AppAccentSecondary" Color="{StaticResource AppAccentSecondaryColor}" />
    <SolidColorBrush x:Key="AppTelemetry" Color="{StaticResource AppTelemetryColor}" />
    <SolidColorBrush x:Key="AppMagenta" Color="{StaticResource AppMagentaColor}" />
    <SolidColorBrush x:Key="AppInfo" Color="{StaticResource AppInfoColor}" />

    <!-- ── Brushes: text ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource AppTextMutedColor}" />
    <SolidColorBrush x:Key="AppTextPrimary" Color="{StaticResource AppTextPrimaryColor}" />
    <SolidColorBrush x:Key="AppTextSecondary" Color="{StaticResource AppTextSecondaryColor}" />

    <!-- ── Brushes: status ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <!-- ── Focus brush ──────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource AppTelemetryColor}" />

    <!-- ── Typography (spec §3.4) ──────────────────────────────────────────── -->
    <FontFamily x:Key="PrimaryFont">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="HeaderFont">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="NumeralFont">Cascadia Mono, Consolas, monospace</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, monospace</FontFamily>

    <!-- Restrained depth effects (spec §3.3, §14) -->
    <DropShadowEffect x:Key="AccentGlowEffect" Color="{StaticResource AppAccentColor}"
                      BlurRadius="8" ShadowDepth="0" Opacity="0.30" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="TelemetryGlowEffect" Color="{StaticResource AppTelemetryColor}"
                      BlurRadius="8" ShadowDepth="0" Opacity="0.30" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="ButtonGlowEffect" Color="{StaticResource AppAccentColor}"
                      BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.30" RenderingBias="Performance"/>

    <!-- Restrained contact shadow for precision card depth -->
    <DropShadowEffect x:Key="CardShadowEffect" Color="#000000" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.35" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="RaisedCardShadowEffect" Color="#000000" BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.45" RenderingBias="Performance"/>

    <!-- ══════════════════════════════════════════════════════════════════
         TEXT STYLES / TYPE SCALE (spec §3.4)
         ══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SubheaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SecondaryAccentBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>

    <Style x:Key="TelemetryValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HeaderFont}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="TelemetryLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MetadataTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="TechnicalLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         NAVIGATION (spec §4.1)
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Primary nav button: structured technical tile with left accent line -->
    <Style x:Key="ClayNavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,8"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,2"
                                BorderBrush="Transparent" BorderThickness="1"/>
                        <Border x:Name="AccentBar" Width="2" CornerRadius="1"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Margin="2,6,0,6" Background="{StaticResource PrimaryAccentBrush}" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource AppClayHighlight}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource InsetSurfaceBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource ClayNavSelectedFaceBrush}"/>
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AppAccentDim}"/>
                            <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary (contextual) nav: compact technical tab with subtle highlight -->
    <Style x:Key="ClaySecondaryNavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource AppClayHighlight}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource AppAccentDim}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource AppClayHighlight}"/>
                            <Setter Property="Foreground" Value="{StaticResource SecondaryAccentBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon button: structured with precision border -->
    <Style x:Key="ClayIconButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource RaisedSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppClayHighlight}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AppAccentDim}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppAccentDim}"/>
                            <Setter Property="Foreground" Value="{StaticResource SecondaryAccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Legacy keys (kept so existing views keep working) -->
    <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource ClayNavButton}"/>
    <Style x:Key="NavButtonSelectedStyle" TargetType="Button" BasedOn="{StaticResource ClayNavButton}"/>

    <!-- ══════════════════════════════════════════════════════════════════
         BUTTONS (spec §3.3)
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Primary action button: crisp precision accent technical button -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ClayPrimaryFaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AppBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource AppAccentColor}" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.30" RenderingBias="Performance"/>
                            </Border.Effect>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ClayPrimaryFaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource ClayPrimaryFacePressedBrush}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AppClayHighlight}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource TelemetryAccentBrush}"/>
                            <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary button: precision gunmetal slab with border -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ClayCardFaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ClayEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.25" RenderingBias="Performance"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ClayCardFaceHoverBrush}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AppAccentDim}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource InsetSurfaceBrush}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource TelemetryAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Destructive button: elevated red-tinted technical button -->
    <Style x:Key="DestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="BorderBrush" Value="#66FDA4AF"/>
    </Style>

    <!-- Compact button variant -->
    <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Clay aliases -->
    <Style x:Key="ClayPrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}"/>
    <Style x:Key="ClaySecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"/>
    <Style x:Key="ClayButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"/>

    <!-- ══════════════════════════════════════════════════════════════════
         CARDS / PANELS — Precision Depth surfaces
         Machined panels with subtle lighting and recessed wells.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Precision Card: machined gunmetal surface with 1px border -->
    <Style x:Key="ClayCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ClayCardFaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ClayEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect" Value="{StaticResource CardShadowEffect}"/>
    </Style>

    <!-- Larger raised panel -->
    <Style x:Key="ClayPanel" TargetType="Border" BasedOn="{StaticResource ClayCard}">
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Compact stat tile for metric displays -->
    <Style x:Key="ClayStatTile" TargetType="Border" BasedOn="{StaticResource ClayCard}">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="MinWidth" Value="130"/>
    </Style>

    <!-- Hero card: prominent chassis card -->
    <Style x:Key="ClayHeroCard" TargetType="Border" BasedOn="{StaticResource ClayCard}">
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect" Value="{StaticResource RaisedCardShadowEffect}"/>
    </Style>

    <!-- Inset (recessed) surface for meters, graphs, input areas -->
    <Style x:Key="ClayInset" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ClayInsetBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ClayInsetBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- Deep inset for telemetry tracks -->
    <Style x:Key="ClayDeepInset" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ClayInsetBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <!-- Status pill / badge -->
    <Style x:Key="ClayStatusPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppAccentDim}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- Capability tile for hardware support display -->
    <Style x:Key="CapabilityTile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         SEGMENTED CONTROL (spec §3.3) - ListBox-based with keyboard nav
         ══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="ClaySegmentedItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Seg" Background="Transparent" CornerRadius="3" Margin="2,2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Seg" Property="Background" Value="{StaticResource AppClayHighlight}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Seg" Property="Background" Value="{StaticResource ClayPrimaryFaceBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AppBackgroundBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Seg" Property="Background" Value="{StaticResource ClayPrimaryFaceHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AppBackgroundBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Seg" Property="BorderBrush" Value="{StaticResource TelemetryAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented control track -->
    <Style x:Key="ClaySegmented" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ClaySegmentedItem}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                                       HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                       VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter SnapsToDevicePixels="True"/>
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         TOGGLE SWITCH (CheckBox as precision switch) - spec §3.3
         ══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="ClayToggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="34" Height="18" CornerRadius="3"
                                Background="{StaticResource AppClayHighlight}"
                                BorderBrush="{StaticResource AppBorder}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Border x:Name="Knob" Width="12" Height="12" CornerRadius="2"
                                    Background="{StaticResource TextSecondaryBrush}"
                                    HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AppAccentDim}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                            <Setter TargetName="Knob" Property="Background" Value="{StaticResource SecondaryAccentBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AppAccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TelemetryAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default CheckBox becomes clay switch -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource ClayToggle}"/>

    <!-- ══════════════════════════════════════════════════════════════════
         DROPDOWNS / COMBOBOXES (spec §3.3, §11)
         Dark popup, readable items, keyboard nav.
         ══════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppClayHighlight}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppAccentDim}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="1" CornerRadius="4">
                                        <Path x:Name="Arrow" Data="M0,0 L4,4 8,0 Z" Fill="{StaticResource TextSecondaryBrush}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AppAccentDim}"/>
                                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource SecondaryAccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Background="{StaticResource RaisedSurfaceBrush}"
                                    BorderBrush="{StaticResource ClayEdgeBrush}" BorderThickness="1"
                                    CornerRadius="4" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4">
                                <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         TOOLTIPS / POPUP SURFACES (spec §3.3, §11)
         ══════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource RaisedSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderLift}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MaxWidth" Value="380"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         TEXT INPUTS / LISTS (spec §3.3)
         ══════════════════════════════════════════════════════════════════ -->

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource SecondaryAccentBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppBorderLift}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppClayHighlight}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppAccentDim}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         TABLES / LISTVIEWS (spec §3.3)
         ══════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ListView">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
    </Style>

    <Style x:Key="ClayGridViewHeaderStyle" TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ClayGridViewHeaderStyle}"/>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridViewColumnHeader.Column}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppClayHighlight}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppAccentDim}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         SCROLLBARS — Sleek dark scrollbars
         ══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder"
                            Background="{StaticResource AppBorderLift}"
                            CornerRadius="2"
                            Margin="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource SecondaryAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         TABS (for dialogs like SessionReportWindow)
         ══════════════════════════════════════════════════════════════════ -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppClayHighlight}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         EMPTY STATE / UNSUPPORTED STATE STYLES (spec §3.3, §5.2, §6.2)
         ══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="EmptyStateStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="40"/>
    </Style>

    <Style x:Key="UnsupportedCapabilityStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         LEGACY ALIASES — keep every pre-redesign view/window compiling.
         ══════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="AppBackgroundPrimary" Color="{StaticResource AppBackgroundPrimaryColor}" />
    <SolidColorBrush x:Key="AppBackgroundSecondary" Color="{StaticResource AppBackgroundSecondaryColor}" />
    <SolidColorBrush x:Key="AppBackgroundTertiary" Color="{StaticResource AppBackgroundTertiaryColor}" />
    <SolidColorBrush x:Key="AppCyan" Color="{StaticResource AppTelemetryColor}" />

    <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource ClayCard}"/>
    <Style x:Key="HeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTitleStyle}"/>
    <Style x:Key="SubheaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubheaderStyle}"/>
    <Style x:Key="ClayMetric" TargetType="TextBlock" BasedOn="{StaticResource TelemetryValueStyle}"/>
    <Style x:Key="ClayMetricLabel" TargetType="TextBlock" BasedOn="{StaticResource TelemetryLabelStyle}"/>
    <Style x:Key="ClaySectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeadingStyle}"/>

</ResourceDictionary>

