<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DellGamingControlCenter.App</RootNamespace>
    <AssemblyName>DellGamingControlCenter</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Title>GamerHub — PC Gaming Control Center</Title>
    <Description>Lightweight hardware tuning and gaming optimization for Windows gaming laptops and desktops. An independent utility.</Description>
    <Company>Independent</Company>
    <Product>GamerHub</Product>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>..\..\assets\GamerHub.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DellGamingControlCenter.Core\DellGamingControlCenter.Core.csproj" />
    <ProjectReference Include="..\DellGamingControlCenter.Services\DellGamingControlCenter.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
