<UserControl x:Class="DellGamingControlCenter.App.Controls.Hardware3DCoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="400"
             Focusable="True"
             Cursor="Hand"
             Background="Transparent">

    <Grid x:Name="RootContainer" ClipToBounds="True">
        <!-- 3D Viewport hosting the real hardware geometry -->
        <Viewport3D x:Name="CoreViewport" IsHitTestVisible="False">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="CoreCamera"
                                   Position="2.8, 2.5, 3.8"
                                   LookDirection="-2.8, -2.5, -3.8"
                                   UpDirection="0, 1, 0"
                                   FieldOfView="40"/>
            </Viewport3D.Camera>

            <!-- 3D Lights and Models populated in code-behind via MeshBuilder3D -->
            <ModelVisual3D x:Name="RootModelGroupVisual" />
        </Viewport3D>

        <!-- Technical HUD Overlay Framing (Precision Depth) -->
        <Border BorderBrush="{StaticResource AppBorder}" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False">
            <Grid>
                <!-- Top-Left Technical Spec Tag -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="6" Height="6" CornerRadius="1" Background="{StaticResource PrimaryAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="HARDWARE ENGINE // CORE CHASSIS" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Geometric 3D Viewport // Interactive Telemetry Model" FontFamily="{StaticResource PrimaryFont}" FontSize="9"
                               Foreground="{StaticResource TextMutedBrush}" Margin="12,2,0,0"/>
                </StackPanel>

                <!-- Top-Right Technical Grid Alignment Coordinate Marker -->
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
                           Text="ORTHO: 42° // D3D9/11" FontFamily="{StaticResource MonoFont}" FontSize="9"
                           Foreground="{StaticResource TextMutedBrush}"/>

                <!-- Bottom Status & Controls Bar -->
                <Grid VerticalAlignment="Bottom" Margin="12,0,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PARALLAX: " FontFamily="{StaticResource MonoFont}" FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="ParallaxStatusText" Text="HOVER TO INSPECT" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                   Foreground="{StaticResource PrimaryAccentBrush}"/>
                    </StackPanel>

                    <!-- Reset View Action -->
                    <Button Grid.Column="1" x:Name="ResetButton" Content="RESET ANGLE"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,4" FontSize="9" FontFamily="{StaticResource MonoFont}"
                            AutomationProperties.Name="Reset 3D View"
                            Click="ResetButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
