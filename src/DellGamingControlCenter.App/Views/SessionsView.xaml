<UserControl x:Class="DellGamingControlCenter.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Session History" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,20"/>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Table Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="GAME" Style="{StaticResource SubheaderTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="DATE" Style="{StaticResource SubheaderTextStyle}"/>
                            <TextBlock Grid.Column="2" Text="DURATION" Style="{StaticResource SubheaderTextStyle}"/>
                            <TextBlock Grid.Column="3" Text="HEALTH" Style="{StaticResource SubheaderTextStyle}"/>
                            <TextBlock Grid.Column="4" Text="BOTTLENECK" Style="{StaticResource SubheaderTextStyle}"/>
                            <TextBlock Grid.Column="5" Text="OPTIMIZATION" Style="{StaticResource SubheaderTextStyle}"/>
                            <TextBlock Grid.Column="6" Text="RESTORATION" Style="{StaticResource SubheaderTextStyle}"/>
                        </Grid>
                        
                        <!-- Table Body -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Sessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource AppBorder}" BorderThickness="0,1,0,0" Padding="0,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" Text="{Binding Game}" Foreground="{StaticResource AppTextPrimary}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Date}" Foreground="{StaticResource AppTextSecondary}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="{StaticResource AppTextSecondary}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Health}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="4" Text="{Binding PrimaryBottleneck}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Optimization}" Foreground="{StaticResource AppTextSecondary}"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Restoration}" Foreground="{StaticResource AppTextSecondary}"/>
                                            
                                            <Button Grid.Column="7" Content="VIEW REPORT" Command="{Binding DataContext.ViewReportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="15,5"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
