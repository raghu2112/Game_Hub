<Window x:Class="DellGamingControlCenter.App.Views.SmartOptimizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Optimizer" Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource PrimaryFont}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="SMART OPTIMIZER" Style="{StaticResource SubheaderStyle}"/>
            <TextBlock Text="{Binding GameName}" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Content="SCAN SYSTEM" Command="{Binding ScanCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondary}"/>
                </StackPanel>

                <!-- Plan -->
                <StackPanel Grid.Row="1" Visibility="{Binding HasPlan, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="OPTIMIZATION PLAN" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"/>
                    
                    <ItemsControl ItemsSource="{Binding PlanActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="✓" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{StaticResource AppTextPrimary}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RiskLevel, StringFormat='Risk: {0}'}" Foreground="{StaticResource AppTextSecondary}" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="CANCEL" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
            <Button Content="APPLY OPTIMIZATION" Command="{Binding ApplyCommand}" Style="{StaticResource ActionButtonStyle}" IsEnabled="{Binding HasPlan}" Padding="18,9"/>
        </StackPanel>
    </Grid>
</Window>
