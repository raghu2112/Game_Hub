<UserControl x:Class="DellGamingControlCenter.App.Views.GameCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER (spec §6) ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="GAME LIBRARY" Style="{StaticResource SubheaderStyle}"/>
                <TextBlock Text="Game Center" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Search -->
            <Border Grid.Column="1" Background="{StaticResource InsetSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorder}" BorderThickness="1"
                    CornerRadius="4" Width="250" Height="34" VerticalAlignment="Center" Margin="0,0,14,0">
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                    <TextBox BorderThickness="0" Background="Transparent" Padding="30,0,10,0"
                             VerticalContentAlignment="Center" FontSize="11.5"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource SecondaryAccentBrush}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter your library"/>
                </Grid>
            </Border>

            <Button Grid.Column="2" Content="ADD GAME" Command="{Binding AddGameCommand}"
                    Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center"
                    AutomationProperties.Name="Add Game to Library"/>
        </Grid>

        <!-- ═══════════ ACTIVE SESSION CARD (live, real session data) ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource ClayCard}" BorderThickness="1"
                BorderBrush="{StaticResource PrimaryAccentBrush}"
                Visibility="{Binding HasActiveSession, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,30,0">
                    <TextBlock Text="ACTIVE GAME" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ActiveGameName}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="{Binding ActiveExecutable}" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" Margin="0,3,0,12" TextTrimming="CharacterEllipsis" MaxWidth="320"
                               FontFamily="{StaticResource MonoFont}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Status:" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding ActiveSessionState}" Grid.Column="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12"/>

                        <TextBlock Text="Duration:" Grid.Column="0" Grid.Row="1" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SessionDuration}" Grid.Column="1" Grid.Row="1"
                                   Foreground="{StaticResource SecondaryAccentBrush}" FontWeight="Bold"
                                   Margin="0,6,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                    </Grid>
                </StackPanel>

                <!-- Live telemetry: real values or "Unavailable" -->
                <StackPanel Grid.Column="1" Margin="20,0">
                    <TextBlock Text="LIVE TELEMETRY" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="CPU" Style="{StaticResource TelemetryLabelStyle}"/>
                            <TextBlock Text="{Binding ActiveCpuUsage}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="RAM" Style="{StaticResource TelemetryLabelStyle}"/>
                            <TextBlock Text="{Binding ActiveRamUsage}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="GPU" Style="{StaticResource TelemetryLabelStyle}"/>
                            <TextBlock Text="{Binding ActiveGpuUsage}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="APPLIED POLICIES" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding AppliedPolicies}" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="2" MaxWidth="250">
                    <TextBlock Text="PROFILE SETTINGS" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ActiveProfileMode, StringFormat='Power: {0}'}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding ActiveGpuPreference, StringFormat='GPU: {0}'}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding ActiveProcessPriority, StringFormat='Priority: {0}'}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>

                    <TextBlock Text="SESSION DIAGNOSTICS" Style="{StaticResource SubheaderStyle}" Margin="14,12,0,6"/>
                    <TextBlock Text="{Binding ActiveSessionDiagnostics}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ MAIN CONTENT: library + recent ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Game library card grid (spec §6.1) -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="LIBRARY" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding FilteredProfiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="268" CornerRadius="4" Margin="0,0,16,16">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource ClayCard}">
                                                <Setter Property="Padding" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <!-- Artwork: bundled → exe icon → generated placeholder -->
                                            <Border Height="136" CornerRadius="3,3,0,0">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Margin="10,10,0,0" Background="#CC101218"
                                                        CornerRadius="2" Padding="7,2.5">
                                                    <TextBlock Text="{Binding ProfileStatus}" FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource SecondaryAccentBrush}"/>
                                                </Border>
                                            </Border>

                                            <!-- Info -->
                                            <StackPanel Margin="14,12,14,14">
                                                <TextBlock Text="{Binding GameName}" FontSize="15" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="40"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ExecutablePath}" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ExecutablePath}"
                                                           Margin="0,4,0,0"/>

                                                <!-- Policy chips -->
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Border Style="{StaticResource ClayStatusPill}">
                                                        <TextBlock Text="{Binding GpuPreferenceText, StringFormat='GPU: {0}'}"
                                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource ClayStatusPill}">
                                                        <TextBlock Text="{Binding PowerModeText, StringFormat='Power: {0}'}"
                                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource ClayStatusPill}">
                                                        <TextBlock Text="{Binding PriorityText, StringFormat='Priority: {0}'}"
                                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Quick stats -->
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="LAST PLAYED" Style="{StaticResource TechnicalLabelStyle}"/>
                                                        <TextBlock Text="{Binding LastPlayed}" FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="SESSIONS" Style="{StaticResource TechnicalLabelStyle}"/>
                                                        <TextBlock Text="{Binding SessionCount}" FontSize="12"
                                                                   FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="AVG LOAD" Style="{StaticResource TechnicalLabelStyle}"/>
                                                        <TextBlock Text="{Binding AverageCpu}" FontSize="12"
                                                                   FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Actions -->
                                                <Grid Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="PLAY" MinWidth="70"
                                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Profile.GameId}"
                                                            IsEnabled="{Binding IsEnabled}"
                                                            Style="{StaticResource ActionButtonStyle}"
                                                            AutomationProperties.Name="Launch Game"/>
                                                    <Button Grid.Column="1" Content="EDIT" MinWidth="60" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.ProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Profile.GameId}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            AutomationProperties.Name="Edit Game Profile"/>
                                                    <Button Grid.Column="2" AutomationProperties.Name="Remove game"
                                                            MinWidth="40" Margin="8,0,0,0"
                                                            ToolTip="Remove from library"
                                                            Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Profile.GameId}"
                                                            Style="{StaticResource DestructiveButtonStyle}">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state (spec §6.3) -->
                        <StackPanel Style="{StaticResource EmptyStateStyle}"
                                    Visibility="{Binding FilteredProfiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <TextBlock Text="No games in your library." FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Add any Windows game executable to create a profile."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <!-- Recent games analytics -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding RecentGames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ClayCard}" Margin="0,0,0,12" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding GameName}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding LastPlayedText, StringFormat='Last played: {0}'}"
                                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,3,0,10"/>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="SESSIONS" Style="{StaticResource TechnicalLabelStyle}"/>
                                                    <TextBlock Text="{Binding SessionCount}" FontSize="12"
                                                               FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="AVG CPU · RAM" Style="{StaticResource TechnicalLabelStyle}"/>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               Foreground="{StaticResource TextPrimaryBrush}">
                                                        <Run Text="{Binding AverageCpu, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AverageRam, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="Location: " Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding StorageLocation}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Style="{StaticResource EmptyStateStyle}"
                                    Visibility="{Binding RecentGames.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <TextBlock Text="No recent activity." FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Play a game to record session history."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
