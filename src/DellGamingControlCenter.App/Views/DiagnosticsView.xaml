<UserControl x:Class="DellGamingControlCenter.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DellGamingControlCenter.App.Controls"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER (spec §8) ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="TECHNICAL INSIGHTS" Style="{StaticResource SubheaderStyle}"/>
                <TextBlock Text="Diagnostics" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,4"/>
                <TextBlock Text="Findings come from the DiagnosticEngine analyzing live telemetry snapshots."
                           Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <Button Grid.Column="1" Content="RUN DIAGNOSTIC" Command="{Binding RunDiagnosticCommand}"
                    Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center"
                    IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBooleanConverter}}"/>
        </Grid>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Loading / honest in-progress state -->
                <Border Style="{StaticResource ClayCard}" Margin="0,0,0,18"
                        Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Analyzing system metrics…"
                                   Foreground="{StaticResource SecondaryAccentBrush}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Collecting evidence from the live telemetry pipeline."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Visibility="{Binding IsAnalyzing, Converter={StaticResource InverseBooleanConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: findings + recommendations -->
                    <StackPanel Grid.Column="0">
                        <!-- Primary bottleneck card: hidden when the engine found nothing -->
                        <Border Style="{StaticResource ClayCard}" Margin="0,0,0,16"
                                Visibility="{Binding PrimaryBottleneckName, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="PRIMARY BOTTLENECK ANALYSIS" Style="{StaticResource SubheaderStyle}"/>
                                <TextBlock Text="{Binding PrimaryBottleneckName}" FontSize="21" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,10,0,5" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding PrimaryBottleneckConfidence, StringFormat='Confidence: {0}'}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding PrimaryBottleneckExplanation}"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                                           Style="{StaticResource BodyTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Findings list with severity indicators (spec §8) -->
                        <TextBlock Text="FINDINGS" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"
                                   Visibility="{Binding Findings.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=NonEmpty}"/>
                        <ItemsControl ItemsSource="{Binding Findings}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ClayCard}" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Severity marker: shape + text, never colour alone (spec §8) -->
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Top">
                                                <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Top" Margin="0,4,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource TelemetryAccentBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                    <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Notice">
                                                                    <Setter Property="Background" Value="{StaticResource SecondaryAccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Severity}" FontWeight="Bold" FontSize="12"
                                                               Margin="0,0,10,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TelemetryAccentBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Category}" FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Border Style="{StaticResource ClayStatusPill}">
                                                        <TextBlock Text="{Binding ObservedValue, StringFormat='Observed: {0}'}"
                                                                   FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource ClayStatusPill}" Margin="0,0,0,0">
                                                        <TextBlock Text="{Binding ReferenceRange, StringFormat='Reference: {0}'}"
                                                                   FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding RecommendedAction}" FontSize="12"
                                                           Foreground="{StaticResource SuccessBrush}" FontStyle="Italic"
                                                           TextWrapping="Wrap" Margin="0,7,0,0"
                                                           Visibility="{Binding RecommendedAction, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Recommendations -->
                        <TextBlock Text="RECOMMENDATIONS" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ClayCard}" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Reason}" Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" FontSize="12.5" Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                                                <TextBlock Text="IMPACT" Style="{StaticResource TechnicalLabelStyle}"/>
                                                <TextBlock Text="{Binding ExpectedImpact}" Foreground="{StaticResource SuccessBrush}"
                                                           FontWeight="Bold" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="RISK" Style="{StaticResource TechnicalLabelStyle}"/>
                                                <TextBlock Text="{Binding Risk}" Foreground="{StaticResource WarningBrush}"
                                                           FontWeight="Bold" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Honest empty state (spec §8) -->
                        <StackPanel Margin="0,20,0,20"
                                    Visibility="{Binding Recommendations.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <TextBlock Text="No issues detected" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="GamerHub has no current diagnostic findings to report."
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right column -->
                    <StackPanel Grid.Column="2">
                        <!-- Health gauge -->
                        <Border Style="{StaticResource ClayCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="GAMING HEALTH" Style="{StaticResource SubheaderStyle}"/>
                                <controls:CircularGauge Value="{Binding GamingHealthScore}" Label="SCORE"
                                                        CenterText="{Binding GamingHealthScore}"
                                                        AccentBrush="{StaticResource SuccessBrush}"
                                                        Height="150" Margin="0,8,0,0"/>
                                <TextBlock Text="100 minus severity weights from DiagnosticEngine findings."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Secondary bottleneck -->
                        <Border Style="{StaticResource ClayCard}" Margin="0,0,0,16"
                                Visibility="{Binding SecondaryBottleneckName, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="SECONDARY BOTTLENECK" Style="{StaticResource SubheaderStyle}"/>
                                <TextBlock Text="{Binding SecondaryBottleneckName}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SecondaryBottleneckConfidence, StringFormat='Confidence: {0}'}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- Live metrics (inset readouts) -->
                        <Border Style="{StaticResource ClayCard}">
                            <StackPanel>
                                <TextBlock Text="LIVE METRICS" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="CPU" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding CpuUsage}" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="GPU" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding GpuUsage}" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="RAM" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding RamUsage}" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Storage" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding StorageUsage}" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Thermals" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding Temperature}" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
