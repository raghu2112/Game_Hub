<UserControl x:Class="DellGamingControlCenter.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DellGamingControlCenter.App.Controls"
             xmlns:app="clr-namespace:DellGamingControlCenter.App"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">
            <!-- ═══════════ HERO / COMMAND HEADER (spec §5.1, §7.1) ═══════════ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PRECISION HARDWARE CONSOLE" Style="{StaticResource SubheaderStyle}"/>
                    <TextBlock Text="System Command Center" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding GamingStatus, FallbackValue='No active gaming session'}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="   //   " Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                        <TextBlock Text="{Binding PerformanceMode, StringFormat='Power Mode: {0}', FallbackValue='Power Mode: Default'}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Toolbar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="OPEN GAMES" Command="{Binding ViewRecommendationCommand}"
                            Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"
                            AutomationProperties.Name="Open Game Center"/>
                    <Button Content="POWER MODES" Command="{Binding ChangeModeCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            AutomationProperties.Name="Change Power Mode"/>
                    <Button Content="DIAGNOSTICS" Command="{Binding ViewDiagnosticsCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="Open Diagnostics"/>
                </StackPanel>
            </Grid>

            <!-- ═══════════ HERO ASYMMETRIC VIEWPORT + SPECS DOCK (spec §4.1, §7.1) ═══════════ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Genuine 3D Hardware Telemetry Core (Real Viewport3D) -->
                <Border Grid.Column="0" Style="{StaticResource ClayHeroCard}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="220"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Hero 3D Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="3D HARDWARE TELEMETRY CORE" Style="{StaticResource SubheaderStyle}"/>
                                <TextBlock Text="Interactive Chassis &amp; Die Visualizer"
                                           FontFamily="{StaticResource PrimaryFont}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{StaticResource InsetSurfaceBrush}"
                                    BorderBrush="{StaticResource AppBorder}" BorderThickness="1" CornerRadius="3" Padding="6,3">
                                <TextBlock Text="NATIVE D3D // REAL MESH" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                           Foreground="{StaticResource PrimaryAccentBrush}"/>
                            </Border>
                        </Grid>

                        <!-- Real 3D Viewport Component -->
                        <controls:Hardware3DCoreView Grid.Row="1" Margin="0,2,0,2"/>

                        <!-- 3D Footer Note -->
                        <TextBlock Grid.Row="2" Margin="0,6,0,0"
                                   Text="Precision Direct3D 3D engine with frozen MeshGeometry3D. Hover to engage interactive parallax tracking."
                                   FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                </Border>

                <!-- Right Column: Live Specifications Dock & Quick Control -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Real Hardware Architecture Info -->
                    <Border Grid.Row="0" Style="{StaticResource ClayCard}">
                        <StackPanel>
                            <TextBlock Text="SYSTEM HARDWARE ARCHITECTURE" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"/>

                            <!-- Processor -->
                            <Border Style="{StaticResource ClayDeepInset}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="CENTRAL PROCESSOR" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding CpuDetails}" Style="{StaticResource BodyTextStyle}"
                                               FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Graphics -->
                            <Border Style="{StaticResource ClayDeepInset}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="GRAPHICS ADAPTER" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding GpuDetails}" Style="{StaticResource BodyTextStyle}"
                                               FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Memory & Thermal -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource ClayDeepInset}">
                                    <StackPanel>
                                        <TextBlock Text="SYSTEM MEMORY" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding RamDetails}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource ClayDeepInset}">
                                    <StackPanel>
                                        <TextBlock Text="THERMAL SENSOR" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Temperature}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Environment & Diagnostics Summary -->
                    <Border Grid.Row="2" Style="{StaticResource ClayCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DIAGNOSTIC STATUS" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource BodyTextStyle}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="INSPECT" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ViewDiagnosticsCommand}" VerticalAlignment="Center"
                                    AutomationProperties.Name="Inspect Diagnostics Finding"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ═══════════ TELEMETRY INSTRUMENT CONSOLE ═══════════ -->
            <Border Style="{StaticResource ClayCard}" Margin="0,0,0,20" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Col 0: Primary Processor Radial Instrument -->
                        <ColumnDefinition Width="190"/>
                        <!-- Col 1: Vertical Divider -->
                        <ColumnDefinition Width="1"/>
                        <!-- Col 2: High-Density Linear Telemetry Meters (GPU, RAM, Thermals) -->
                        <ColumnDefinition Width="*"/>
                        <!-- Col 3: Vertical Divider -->
                        <ColumnDefinition Width="1"/>
                        <!-- Col 4: System Health & Diagnostic Confidence Badge -->
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Col 0: Primary CPU Dial with direct clock and core load -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="PRIMARY PROCESSOR" Style="{StaticResource TechnicalLabelStyle}" Margin="0,0,0,8"/>
                        <controls:CircularGauge Value="{Binding CpuPercent}" Label="CPU CORE"
                                                AccentBrush="{StaticResource PrimaryAccentBrush}" Height="110"/>
                        <TextBlock Text="{Binding CpuUsage}" Style="{StaticResource TelemetryLabelStyle}"
                                   HorizontalAlignment="Center" Margin="0,6,0,2"/>
                        <TextBlock Text="{Binding CpuDetails}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CpuDetails}"/>
                    </StackPanel>

                    <!-- Divider 1 -->
                    <Rectangle Grid.Column="1" Fill="{StaticResource AppBorder}" Margin="0,4"/>

                    <!-- Col 2: Linear Precision Meters (GPU, RAM, Thermals) -->
                    <Grid Grid.Column="2" Margin="20,0,20,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- GPU Meter -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="GPU LOAD" Style="{StaticResource TechnicalLabelStyle}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding GpuDetails}" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTip="{Binding GpuDetails}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding GpuUsage}" Style="{StaticResource TelemetryLabelStyle}"
                                           HorizontalAlignment="Right" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            </Grid>
                            <controls:MeterBar Value="{Binding GpuPercent}" BarHeight="7"
                                               FillBrush="{StaticResource PrimaryAccentBrush}"
                                               TrackBrush="{StaticResource InsetSurfaceBrush}"/>
                        </StackPanel>

                        <!-- RAM Meter -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SYSTEM MEMORY" Style="{StaticResource TechnicalLabelStyle}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding RamDetails}" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTip="{Binding RamDetails}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding RamUsage}" Style="{StaticResource TelemetryLabelStyle}"
                                           HorizontalAlignment="Right" Foreground="{StaticResource SecondaryAccentBrush}"/>
                            </Grid>
                            <controls:MeterBar Value="{Binding RamPercent}" BarHeight="7"
                                               FillBrush="{StaticResource SecondaryAccentBrush}"
                                               TrackBrush="{StaticResource InsetSurfaceBrush}"/>
                        </StackPanel>

                        <!-- Thermal Sensor & Package Status -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="THERMAL PACKAGE" Style="{StaticResource TechnicalLabelStyle}"/>
                                <TextBlock Text="{Binding Temperature, FallbackValue='Normal (Nominal)'}"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                           FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="POWER SUPPLY" Style="{StaticResource TechnicalLabelStyle}"/>
                                <TextBlock Text="{Binding BatteryStatus, FallbackValue='AC Connected'}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                                           FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Divider 2 -->
                    <Rectangle Grid.Column="3" Fill="{StaticResource AppBorder}" Margin="0,4"/>

                    <!-- Col 4: System Health & Diagnostic Confidence Badge -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="DIAGNOSTIC HEALTH" Style="{StaticResource TechnicalLabelStyle}" Margin="0,0,0,8"/>
                        <controls:CircularGauge Value="{Binding GamingHealthScore}" Label="SYS HEALTH"
                                                CenterText="{Binding GamingHealthScore}"
                                                AccentBrush="{StaticResource SuccessBrush}" Height="100"/>
                        <TextBlock Text="Calculated Health Index" Style="{StaticResource TelemetryLabelStyle}"
                                   HorizontalAlignment="Center" Margin="0,4,0,2"/>
                        <TextBlock Text="Authoritative Diagnostic Engine"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="9.5"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════ LIVE TELEMETRY OSCILLOSCOPE (LAST 60 SECONDS) ═══════════ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Rolling 60 s real-time graph array -->
                <Border Grid.Column="0" Style="{StaticResource ClayCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="REAL-TIME TELEMETRY SAMPLES // 60-SEC WINDOW" Style="{StaticResource SubheaderStyle}" VerticalAlignment="Center"/>
                            <TextBlock Text="SAMPLER: 1000ms" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- CPU Track -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CPU" Style="{StaticResource TelemetryLabelStyle}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource ClayInset}" Padding="2">
                                <controls:UsageGraph Height="42" History="{x:Static app:App.CpuHistory}"/>
                            </Border>
                        </Grid>

                        <!-- RAM Track -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="RAM" Style="{StaticResource TelemetryLabelStyle}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource ClayInset}" Padding="2">
                                <controls:UsageGraph Height="42" History="{x:Static app:App.RamHistory}"/>
                            </Border>
                        </Grid>

                        <!-- GPU Track -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GPU" Style="{StaticResource TelemetryLabelStyle}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource ClayInset}" Padding="2">
                                <controls:UsageGraph Height="42" History="{x:Static app:App.GpuHistory}"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- System Resources & Gaming Session Ledger -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource ClayCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SYSTEM STORAGE &amp; BATTERY" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"/>
                            <Border Style="{StaticResource ClayDeepInset}" Margin="0,0,0,8">
                                <TextBlock Text="{Binding StorageUsage, StringFormat='Storage: {0}'}"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Border Style="{StaticResource ClayDeepInset}">
                                <TextBlock Text="{Binding BatteryStatus, StringFormat='Power Supply: {0}'}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ClayCard}">
                        <StackPanel>
                            <TextBlock Text="ACTIVE SESSION PROFILE" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="7" Height="7" CornerRadius="1.5" Background="{StaticResource PrimaryAccentBrush}"
                                        Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding GamingStatus}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding PerformanceMode, StringFormat='Plan: {0}'}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryAccentBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Content="ADJUST" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Right" Command="{Binding ChangeModeCommand}"
                                        Padding="12,5" FontSize="11"
                                        AutomationProperties.Name="Adjust Power Plan"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ═══════════ DIAGNOSTIC INTELLIGENCE FEED ═══════════ -->
            <Border Style="{StaticResource ClayCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="HARDWARE DIAGNOSTIC LOG &amp; RECOMMENDATIONS" Style="{StaticResource SubheaderStyle}"/>
                        <Button HorizontalAlignment="Right" Content="FULL DIAGNOSTIC SUITE"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="10.5"
                                Command="{Binding ViewDiagnosticsCommand}"
                                AutomationProperties.Name="Open Full Diagnostic Suite"/>
                    </Grid>
                    <TextBlock Text="{Binding RecommendationText}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding GamingInsights}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1"
                                        Padding="0,6,0,8" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12.5" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Summary}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11.5" Margin="0,2,0,2" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Recommendation}"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
