<UserControl x:Class="DellGamingControlCenter.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Text="Performance Center" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,20"/>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- Current Status -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CURRENT MODE" Style="{StaticResource SubheaderTextStyle}"/>
                            <TextBlock Text="{Binding CurrentMode.Title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AppTextPrimary}" Margin="0,5,0,0"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="POWER PLAN" Style="{StaticResource SubheaderTextStyle}"/>
                            <TextBlock Text="High Performance" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AppTextPrimary}" Margin="0,5,0,0"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="GAME MODE" Style="{StaticResource SubheaderTextStyle}"/>
                            <TextBlock Text="Enabled" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AppTextPrimary}" Margin="0,5,0,0"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="GPU PREFERENCE" Style="{StaticResource SubheaderTextStyle}"/>
                            <TextBlock Text="AMD Radeon 520" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AppTextPrimary}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Modes List -->
                <TextBlock Text="AVAILABLE MODES" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,10"/>
                
                <ItemsControl ItemsSource="{Binding Modes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AppTextPrimary}"/>
                                            <!-- Active Indicator -->
                                            <Border Background="{StaticResource AppAccent}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="ACTIVE" Foreground="#0F1115" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource AppTextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                        
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Power Impact: " Foreground="{StaticResource AppTextSecondary}"/>
                                            <TextBlock Text="{Binding PowerImpact}" Foreground="{StaticResource AppTextPrimary}" FontWeight="SemiBold" Margin="0,0,20,0"/>
                                            
                                            <TextBlock Text="Performance: " Foreground="{StaticResource AppTextSecondary}"/>
                                            <TextBlock Text="{Binding PerformanceIntent}" Foreground="{StaticResource AppTextPrimary}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        
                                        <!-- Warning -->
                                        <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarningBrush}" Margin="0,10,0,0" FontStyle="Italic"/>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="1" Content="ACTIVATE" 
                                            Command="{Binding DataContext.ActivateModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                            CommandParameter="{Binding Mode}" 
                                            Style="{StaticResource ActionButtonStyle}" 
                                            IsEnabled="{Binding IsActive, Converter={StaticResource InverseBooleanConverter}}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
