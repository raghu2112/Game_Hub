<UserControl x:Class="DellGamingControlCenter.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DellGamingControlCenter.App.Controls"
             xmlns:app="clr-namespace:DellGamingControlCenter.App"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- ═══════════ PAGE HEADER (spec §7) ═══════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PERFORMANCE CENTER" Style="{StaticResource SubheaderStyle}"/>
                    <TextBlock Text="System Controls" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,4"/>
                    <TextBlock Text="Selectable modes change Windows power configuration. Hardware capabilities are listed with their actual support state."
                               Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="640"/>
                </StackPanel>
            </Grid>

            <!-- Operation status feedback (spec §7.4) -->
            <Border Style="{StaticResource ClayCard}" Padding="14,10" Margin="0,0,0,18"
                    Visibility="{Binding OperationStatus, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource TelemetryAccentBrush}"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding OperationStatus}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"
                               FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ═══════════ HARDWARE OPERATING STATUS CONSOLE ═══════════ -->
            <Border Style="{StaticResource ClayCard}" Margin="0,0,0,24" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Col 0: Power Mode -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="WINDOWS POWER PLAN" Style="{StaticResource TechnicalLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentPowerModeString}" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Divider 1 -->
                    <Rectangle Grid.Column="1" Fill="{StaticResource AppBorder}" Margin="0,2"/>

                    <!-- Col 2: GPU Preference -->
                    <StackPanel Grid.Column="2" Margin="16,0,16,0">
                        <TextBlock Text="GPU TARGET PREFERENCE" Style="{StaticResource TechnicalLabelStyle}"/>
                        <TextBlock Text="{Binding CurrentGpuPreferenceString}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Divider 2 -->
                    <Rectangle Grid.Column="3" Fill="{StaticResource AppBorder}" Margin="0,2"/>

                    <!-- Col 4: Active Game -->
                    <StackPanel Grid.Column="4" Margin="16,0,16,0">
                        <TextBlock Text="MONITORED GAME PROCESS" Style="{StaticResource TechnicalLabelStyle}"/>
                        <TextBlock Text="{Binding ActiveGameName}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Divider 3 -->
                    <Rectangle Grid.Column="5" Fill="{StaticResource AppBorder}" Margin="0,2"/>

                    <!-- Col 6: Profile Name -->
                    <StackPanel Grid.Column="6" Margin="16,0,0,0">
                        <TextBlock Text="ACTIVE POLICY PROFILE" Style="{StaticResource TechnicalLabelStyle}"/>
                        <TextBlock Text="{Binding ActiveProfileName}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryAccentBrush}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════ LIVE UTILIZATION ═══════════ -->
            <TextBlock Text="LIVE UTILIZATION (LAST 60 SECONDS)" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource ClayCard}" Margin="0,0,0,24">
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="CPU" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource ClayInset}" Margin="0,6,0,0" Padding="3">
                            <controls:UsageGraph Height="90" History="{x:Static app:App.CpuHistory}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="MEMORY" Foreground="{StaticResource SecondaryAccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource ClayInset}" Margin="0,6,0,0" Padding="3">
                            <controls:UsageGraph Height="90" History="{x:Static app:App.RamHistory}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="GPU" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource ClayInset}" Margin="0,6,0,0" Padding="3">
                            <controls:UsageGraph Height="90" History="{x:Static app:App.GpuHistory}"/>
                        </Border>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- ═══════════ PERFORMANCE MODE SELECTOR (spec §7.1) ═══════════
                 Real PerformanceMode enum values; ACTIVATE applies through
                 ChangePerformanceModeUseCase and only re-reads state after the
                 backend confirms. -->
            <TextBlock Text="POWER MODES" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"/>
            <ItemsControl ItemsSource="{Binding Modes}" Margin="0,0,0,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ClayCard}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                            <Setter Property="Background" Value="{StaticResource RaisedSurfaceBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Border Background="{StaticResource PrimaryAccentBrush}" CornerRadius="5"
                                                Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="ACTIVE" Foreground="{StaticResource AppBackgroundBrush}"
                                                       FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"
                                               TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}"/>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Power impact: " Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding PowerImpact}" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="12" Margin="0,0,18,0"/>
                                        <TextBlock Text="Intent: " Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding PerformanceIntent}" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarningBrush}"
                                               Margin="0,8,0,0" FontStyle="Italic" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="ACTIVATE"
                                        Command="{Binding DataContext.ActivateModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Mode}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        IsEnabled="{Binding IsActive, Converter={StaticResource InverseBooleanConverter}}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══════════ ACTIVE GAME POLICY ═══════════ -->
            <TextBlock Text="ACTIVE GAME POLICY" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource ClayCard}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,14">
                        <TextBlock Text="POWER POLICY" Style="{StaticResource TelemetryLabelStyle}"/>
                        <TextBlock Text="{Binding ActivePowerPolicy}" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="GPU POLICY" Style="{StaticResource TelemetryLabelStyle}"/>
                        <TextBlock Text="{Binding ActiveGpuPolicy}" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="PROCESS PRIORITY" Style="{StaticResource TelemetryLabelStyle}"/>
                        <TextBlock Text="{Binding ActivePriorityPolicy}" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="POLICY STATUS" Style="{StaticResource TelemetryLabelStyle}"/>
                        <TextBlock Text="{Binding ActivePolicyStatus}" Foreground="{StaticResource SecondaryAccentBrush}"
                                   FontSize="15" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════ HARDWARE CAPABILITY MATRIX (spec §7.2) ═══════════ -->
            <TextBlock Text="HARDWARE SUPPORT" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource ClayCard}" Margin="0,0,0,24">
                <StackPanel>
                <ItemsControl ItemsSource="{Binding Capabilities}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CapabilityTile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <!-- Status chip: deliberate disabled presentation for unsupported -->
                                    <Border Grid.Column="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource AppAccentDim}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource AppBackgroundPrimary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Unsupported entries are reported by the capability detector. No control is offered for them."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontStyle="Italic"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ═══════════ PERFORMANCE INSIGHTS ═══════════ -->
            <TextBlock Text="PERFORMANCE INSIGHTS" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource ClayCard}">
                <StackPanel>
                <TextBlock Text="No insights right now. Insights appear once the intelligence engine has data."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding PerformanceInsights.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                <ItemsControl ItemsSource="{Binding PerformanceInsights}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1"
                                    Padding="0,6,0,10" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="13" Margin="0,5,0,5" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Recommendation, StringFormat='Recommendation: {0}'}"
                                               Foreground="{StaticResource SuccessBrush}" FontSize="12"
                                               FontStyle="Italic" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
