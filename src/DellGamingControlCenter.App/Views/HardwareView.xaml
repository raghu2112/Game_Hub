<UserControl x:Class="DellGamingControlCenter.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Hardware Specifications" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,20"/>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="SYSTEM" Style="{StaticResource SubheaderTextStyle}"/>
                                <TextBlock Text="{Binding SystemModel}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AppTextPrimary}" Margin="0,5,0,20"/>
                                
                                <TextBlock Text="CPU" Style="{StaticResource SubheaderTextStyle}"/>
                                <TextBlock Text="{Binding CpuName}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}" Margin="0,5,0,20"/>
                                
                                <TextBlock Text="GPU" Style="{StaticResource SubheaderTextStyle}"/>
                                <TextBlock Text="{Binding Gpu1Name}" FontSize="16" Foreground="{StaticResource AppTextPrimary}" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Gpu2Name}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}" Margin="0,5,0,20"/>
                                
                                <TextBlock Text="MEMORY" Style="{StaticResource SubheaderTextStyle}"/>
                                <TextBlock Text="{Binding MemoryInfo}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}" Margin="0,5,0,20"/>
                                
                                <TextBlock Text="STORAGE" Style="{StaticResource SubheaderTextStyle}"/>
                                <TextBlock Text="{Binding Storage1Info}" FontSize="16" Foreground="{StaticResource AppTextPrimary}" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Storage2Info}" FontSize="16" Foreground="{StaticResource AppTextPrimary}" Margin="0,5,0,20"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="CAPABILITIES" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,15"/>
                                
                                <ItemsControl ItemsSource="{Binding Capabilities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,15" Padding="0,0,0,15" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBlock Grid.Column="0" Text="✓" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="18" Visibility="{Binding IsSupported, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <TextBlock Grid.Column="0" Text="✕" Foreground="{StaticResource ErrorBrush}" FontWeight="Bold" FontSize="18" Visibility="{Binding IsSupported, Converter={StaticResource InverseBooleanConverter}}"/>
                                                    
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource AppTextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding IsSupported, Converter={StaticResource InverseBooleanConverter}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
