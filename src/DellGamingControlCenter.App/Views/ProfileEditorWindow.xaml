<Window x:Class="DellGamingControlCenter.App.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Profile" Height="470" Width="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="EDIT PROFILE" Style="{StaticResource SubheaderStyle}"/>
        <TextBlock Text="{Binding GameName}" FontSize="20" FontWeight="Bold" Margin="0,4,0,20"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="GPU Preference:" Margin="0,5,0,5" FontWeight="SemiBold"/>
            <ListBox ItemsSource="{Binding GpuPreferences}" SelectedItem="{Binding SelectedGpuPreference}" IsEnabled="{Binding IsGpuPreferenceSupported}"
                     Margin="0,0,0,10" Style="{StaticResource ClaySegmented}"/>
            <TextBlock Text="Unsupported on this device" Foreground="{StaticResource ErrorBrush}" Visibility="{Binding UnsupportedGpuVisibility}" Margin="0,-5,0,10" FontSize="11"/>

            <TextBlock Text="Power Policy:" Margin="0,5,0,5" FontWeight="SemiBold"/>
            <ListBox ItemsSource="{Binding PerformanceModes}" SelectedItem="{Binding SelectedPerformanceMode}"
                     Margin="0,0,0,10" Style="{StaticResource ClaySegmented}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <TextBlock Text="Process Priority:" Margin="0,5,0,5" FontWeight="SemiBold"/>
            <ListBox ItemsSource="{Binding ProcessPriorities}" SelectedItem="{Binding SelectedProcessPriority}"
                     Margin="0,0,0,10" Style="{StaticResource ClaySegmented}"/>

            <TextBlock Text="Launch Arguments:" Margin="0,5,0,5" FontWeight="SemiBold"/>
            <TextBox Text="{Binding LaunchArguments}" Margin="0,0,0,10"/>

            <TextBlock Text="Fan Control:" Margin="0,5,0,5" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding FanControlStatus}" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,10"/>

            <TextBlock Text="Thermal Control:" Margin="0,5,0,5" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ThermalControlStatus}" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" Margin="0,0,15,0" VerticalAlignment="Center" FontSize="12"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Width="84" Margin="0,0,10,0"
                    Style="{StaticResource ActionButtonStyle}" IsDefault="True"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="84"
                    Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
