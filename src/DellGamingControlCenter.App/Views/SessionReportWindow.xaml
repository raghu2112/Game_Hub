<Window x:Class="DellGamingControlCenter.App.Views.SessionReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Report" Height="580" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="HeaderText" Text="SESSION REPORT" Style="{StaticResource SubheaderStyle}"/>
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="13"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource AppBorder}">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="RECORDED METRICS" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="MetricsText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="APPLIED POLICIES" Style="{StaticResource SubheaderStyle}" Margin="0,16,0,8"/>
                        <TextBlock x:Name="PoliciesText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="RESTORATION" Style="{StaticResource SubheaderStyle}" Margin="0,16,0,8"/>
                        <TextBlock x:Name="RestorationText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Timeline">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <ItemsControl x:Name="TimelineList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1" Padding="0,6,0,10" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Close" Width="90" HorizontalAlignment="Right" Margin="0,16,0,0"
                Style="{StaticResource SecondaryButtonStyle}" Click="OnCloseClick"/>
    </Grid>
</Window>
