<UserControl x:Class="DellGamingControlCenter.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER (spec §11) ═══════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="PREFERENCES" Style="{StaticResource SubheaderStyle}"/>
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,4"/>
            <TextBlock Text="Changes are saved to config.json immediately. Read-only options are marked."
                       Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource ClayCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="GENERAL" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,14"/>
                            <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows, Mode=OneWay}"
                                      IsEnabled="False" Margin="0,0,0,12"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      ToolTip="Read-only: reflects the current registry Run key state."/>
                            <TextBlock Text="Read-only — managed by the installer / registry Run key."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontStyle="Italic"
                                       Margin="34,-8,0,12"/>
                            <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized, Mode=OneWay}"
                                      IsEnabled="False" Margin="0,0,0,12"
                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                            <CheckBox Content="Show in System Tray" IsChecked="{Binding SystemTray}"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ClayCard}">
                        <StackPanel>
                            <TextBlock Text="AUTOMATION" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,14"/>
                            <CheckBox Content="Automatic Optimization" IsChecked="{Binding AutoOptimization}"
                                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <CheckBox Content="Automatic Performance Mode" IsChecked="{Binding AutoPerformanceMode}"
                                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <CheckBox Content="Automatic Background Management" IsChecked="{Binding AutoBackgroundManagement}"
                                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <CheckBox Content="Automatic Restore" IsChecked="{Binding AutoRestore}"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right column -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource ClayCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="SAFETY" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,14"/>
                            <CheckBox Content="Require confirmation before optimization"
                                      IsChecked="{Binding RequireOptimizationConfirmation}"
                                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <CheckBox Content="Require confirmation before closing applications"
                                      IsChecked="{Binding RequireClosingConfirmation}"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ClayCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="MONITORING" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Sampling interval" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding SamplingIntervals}" SelectedItem="{Binding SamplingInterval}"
                                     Style="{StaticResource ClaySegmented}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ClayCard}">
                        <StackPanel>
                            <TextBlock Text="ADVANCED" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Logging level" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel, Mode=OneWay}"
                                     IsEnabled="False" Style="{StaticResource ClaySegmented}"/>
                            <TextBlock Text="Read-only: fixed at Info by design."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontStyle="Italic"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
