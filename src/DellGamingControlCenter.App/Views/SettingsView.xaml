<UserControl x:Class="DellGamingControlCenter.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Settings" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="GENERAL" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,15"/>
                                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Foreground="{StaticResource AppTextPrimary}" Margin="0,0,0,10"/>
                                <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" Foreground="{StaticResource AppTextPrimary}" Margin="0,0,0,10"/>
                                <CheckBox Content="Show in System Tray" IsChecked="{Binding SystemTray}" Foreground="{StaticResource AppTextPrimary}"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="AUTOMATION" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,15"/>
                                <CheckBox Content="Automatic Optimization" IsChecked="{Binding AutoOptimization}" Foreground="{StaticResource AppTextPrimary}" Margin="0,0,0,10"/>
                                <CheckBox Content="Automatic Performance Mode" IsChecked="{Binding AutoPerformanceMode}" Foreground="{StaticResource AppTextPrimary}" Margin="0,0,0,10"/>
                                <CheckBox Content="Automatic Background Management" IsChecked="{Binding AutoBackgroundManagement}" Foreground="{StaticResource AppTextPrimary}" Margin="0,0,0,10"/>
                                <CheckBox Content="Automatic Restore" IsChecked="{Binding AutoRestore}" Foreground="{StaticResource AppTextPrimary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="SAFETY" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,15"/>
                                <CheckBox Content="Require confirmation before optimization" IsChecked="{Binding RequireOptimizationConfirmation}" Foreground="{StaticResource AppTextPrimary}" Margin="0,0,0,10"/>
                                <CheckBox Content="Require confirmation before closing applications" IsChecked="{Binding RequireClosingConfirmation}" Foreground="{StaticResource AppTextPrimary}"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="MONITORING" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,15"/>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Sampling interval" Foreground="{StaticResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding SamplingIntervals}" SelectedItem="{Binding SamplingInterval}" Width="100" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="ADVANCED" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,15"/>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Logging level" Foreground="{StaticResource AppTextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" Width="100" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
