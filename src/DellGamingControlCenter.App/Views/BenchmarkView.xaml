<UserControl x:Class="DellGamingControlCenter.App.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER (spec §10) ═══════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="BENCHMARK CENTER" Style="{StaticResource SubheaderStyle}"/>
            <TextBlock Text="Benchmarks &amp; Analytics" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,4"/>
            <TextBlock Text="A benchmark runs a real session of the selected game and records the DiagnosticEngine health score. It is not an FPS test."
                       Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" MaxWidth="720"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Games list -->
            <Border Grid.Column="0" Style="{StaticResource ClayCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="GAMES" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding DiscoveredGames}"
                             SelectedValue="{Binding SelectedGameId}" SelectedValuePath="Id"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Padding="4,6"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>

            <!-- Detail view -->
            <Border Grid.Column="2" Style="{StaticResource ClayCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="PERFORMANCE STATUS" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,12"/>

                        <Border Style="{StaticResource ClayInset}" Margin="0,0,0,18" Padding="16">
                            <UniformGrid Columns="3">
                                <StackPanel>
                                    <TextBlock Text="BEST HEALTH SCORE" Style="{StaticResource TelemetryLabelStyle}"/>
                                    <TextBlock Text="{Binding BestHealthScore}" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"
                                               FontFamily="{StaticResource MonoFont}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="PRIMARY BOTTLENECK" Style="{StaticResource TelemetryLabelStyle}"/>
                                    <TextBlock Text="{Binding PrimaryBottleneck}" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="CONFIDENCE" Style="{StaticResource TelemetryLabelStyle}"/>
                                    <TextBlock Text="{Binding Confidence}" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource SecondaryAccentBrush}"
                                               FontFamily="{StaticResource MonoFont}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="ACTIONS" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Run Baseline Benchmark" Command="{Binding StartBaselineCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Padding="16,9"/>
                            <Button Content="Run Tuned Benchmark" Command="{Binding StartTunedCommand}"
                                    Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Padding="16,9"/>
                            <Button Content="Cancel" Command="{Binding CancelCommand}"
                                    Style="{StaticResource DestructiveButtonStyle}" Padding="16,9"/>
                        </StackPanel>

                        <!-- Status -->
                        <Border Style="{StaticResource ClayInset}" Padding="12,9" Margin="0,0,0,18"
                                Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryAccentBrush}"
                                       FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="BENCHMARK HISTORY" Style="{StaticResource SubheaderStyle}" Margin="0,0,0,10"/>
                        <TextBlock Text="No benchmarks recorded yet. Run a baseline or tuned benchmark and the run will appear here."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12.5"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding BenchmarkHistory.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                        <ListView ItemsSource="{Binding BenchmarkHistory}"
                                  Visibility="{Binding BenchmarkHistory.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=NonEmpty}">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource ClayGridViewHeaderStyle}">
                                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="110"/>
                                    <GridViewColumn Header="Baseline" DisplayMemberBinding="{Binding IsBaseline}" Width="80"/>
                                    <GridViewColumn Header="Health Score" DisplayMemberBinding="{Binding Result.HealthScore}" Width="110"/>
                                    <GridViewColumn Header="Timestamp" DisplayMemberBinding="{Binding Timestamp}" Width="170"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
