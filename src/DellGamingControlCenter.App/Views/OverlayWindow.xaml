<Window x:Class="DellGamingControlCenter.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gaming Overlay"
        Height="170" Width="210"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False">
    <!-- NOTE: this is a normal transparent WPF window shown on top of the desktop,
         not an injected in-game overlay. It draws no DirectX/Vulkan surfaces. -->
    <Border Background="#E6171521" CornerRadius="14" Padding="14" Margin="8"
            BorderBrush="#3D3552" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="{Binding GameName}" Foreground="{StaticResource AppAccentSecondary}"
                       FontWeight="Bold" FontSize="14" Margin="0,0,0,8"
                       TextTrimming="CharacterEllipsis"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="FPS" Foreground="{StaticResource AppTextSecondary}" FontSize="11" Margin="0,0,12,3"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FpsText}" Foreground="{StaticResource AppTextPrimary}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="CPU" Foreground="{StaticResource AppTextSecondary}" FontSize="11" Margin="0,0,12,3"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CpuText}" Foreground="{StaticResource AppTextPrimary}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="GPU" Foreground="{StaticResource AppTextSecondary}" FontSize="11" Margin="0,0,12,3"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GpuText}" Foreground="{StaticResource AppTextPrimary}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="RAM" Foreground="{StaticResource AppTextSecondary}" FontSize="11" Margin="0,0,12,3"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RamText}" Foreground="{StaticResource AppTextPrimary}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="TEMP" Foreground="{StaticResource AppTextSecondary}" FontSize="11" Margin="0,0,12,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TempText}" Foreground="{StaticResource AppTextPrimary}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
